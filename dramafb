<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Historias IA | Historias que te atrapan</title>
<meta name="description" content="Historias IA: drama, misterio, secretos y giros inesperados. Mira la Parte 2 completa de cada historia.">
<meta name="theme-color" content="#09090d">
<style>
:root{
  --bg:#09090d;--panel:#111118;--panel2:#171720;--text:#f5f5f7;--muted:#a8a8b3;
  --accent:#8b5cf6;--accent2:#ec4899;--line:#252531;--max:1120px;
}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:radial-gradient(circle at 20% -10%,#241442 0,transparent 35%),var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif}
a{color:inherit;text-decoration:none}.container{width:min(92%,var(--max));margin:auto}
header{position:sticky;top:0;z-index:20;background:rgba(9,9,13,.86);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{height:68px;display:flex;align-items:center;justify-content:space-between}
.logo{font-size:21px;font-weight:800;display:flex;gap:10px;align-items:center}
.logo span{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--accent2));}
nav{display:flex;gap:24px;color:#cfcfd8;font-size:14px}
.hero{padding:92px 0 70px;text-align:center}
.eyebrow{font-size:12px;letter-spacing:2px;color:#c4a9ff;font-weight:800}
h1{font-size:clamp(38px,6vw,68px);line-height:1.02;max-width:850px;margin:18px auto}
.hero p{max-width:650px;margin:0 auto 28px;color:var(--muted);font-size:18px;line-height:1.6}
.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:12px;padding:13px 19px;font-weight:800;cursor:pointer}
.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:white}
.section{padding:30px 0 80px}.heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}
h2{font-size:32px;margin:8px 0}.search{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:13px 15px;color:white;width:280px;outline:none}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.2s}
.card:hover{transform:translateY(-4px);border-color:#4a3b67}.thumb{height:180px;display:grid;place-items:center;font-size:65px;background:linear-gradient(135deg,#261443,#151526)}
.thumb.blue{background:linear-gradient(135deg,#102d50,#151526)}.thumb.red{background:linear-gradient(135deg,#4b1825,#151526)}
.card-body{padding:20px}.tag{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#c4a9ff;font-weight:800}
h3{font-size:21px;margin:9px 0}.card p{color:var(--muted);line-height:1.55;min-height:73px}.watch{width:100%;margin-top:8px}
.about{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:30px;margin-bottom:70px}
.about p{color:var(--muted);line-height:1.7}
.reader{display:none;padding:55px 0 80px}.reader.active{display:block}
.back{color:#c4a9ff;font-weight:700;display:inline-block;margin-bottom:25px;cursor:pointer}
.reader h1{font-size:clamp(32px,5vw,54px);margin:12px 0}.reader .desc{color:var(--muted);font-size:17px;line-height:1.6;max-width:780px}
.video{margin:30px auto;background:#000;border:1px solid var(--line);border-radius:16px;overflow:hidden;max-width:900px;aspect-ratio:16/9;display:grid;place-items:center}
.video iframe{width:100%;height:100%;border:0}.video-placeholder{padding:30px;text-align:center;color:var(--muted)}
.video-placeholder strong{display:block;color:white;font-size:20px;margin-bottom:8px}
.more{border-top:1px solid var(--line);padding-top:30px}.more h2{font-size:24px}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:13px}
footer .container{display:flex;justify-content:space-between;gap:20px}
.hidden{display:none!important}
@media(max-width:800px){nav{gap:12px}.grid{grid-template-columns:1fr 1fr}.heading{align-items:stretch;flex-direction:column}.search{width:100%}}
@media(max-width:560px){.hero{padding:65px 0 45px}.grid{grid-template-columns:1fr}.thumb{height:170px}footer .container{flex-direction:column}nav a:first-child{display:none}}
</style>
</head>
<body>
<header>
  <div class="container nav">
    <a class="logo" href="#" onclick="showHome();return false"><span>H</span> Historias <b>IA</b></a>
    <nav><a href="#historias" onclick="showHome()">Historias</a><a href="#sobre">Sobre nosotros</a></nav>
  </div>
</header>

<main id="home">
<section class="hero">
  <div class="container">
    <div class="eyebrow">DRAMA • MISTERIO • SECRETOS • GIROS</div>
    <h1>Historias que empiezan con una decisión y terminan cambiándolo todo.</h1>
    <p>Descubre historias originales. Mira la Parte 1 en nuestras redes y continúa aquí con la Parte 2 completa en video.</p>
    <a class="btn primary" href="#historias">🔥 Ver historias</a>
  </div>
</section>

<section class="section container" id="historias">
  <div class="heading">
    <div><div class="eyebrow">NUEVOS RELATOS</div><h2>Elige una historia</h2></div>
    <input class="search" id="search" type="search" placeholder="🔎 Buscar historia..." oninput="filterStories()">
  </div>
  <div class="grid" id="grid"></div>
</section>

<section class="container" id="sobre">
  <div class="about">
    <div class="eyebrow">SOBRE NOSOTROS</div>
    <h2>Historias IA</h2>
    <p>Proyecto independiente de ficción original creado para entretener, sorprender y generar conversación. Las historias y personajes de este sitio son ficticios.</p>
  </div>
</section>
</main>

<section class="reader" id="reader">
  <div class="container">
    <a class="back" onclick="showHome()">← Volver a historias</a>
    <div id="readerContent"></div>
  </div>
</section>

<footer><div class="container"><span>© 2026 Historias IA</span><span>Ficción original para lectores curiosos.</span></div></footer>

<script>
/* ==========================================================
   VIDEOS: PARA CAMBIAR UN VIDEO EN EL FUTURO, SOLO CAMBIA
   EL valor "video" DE ESA HISTORIA.
   Ejemplo: video:"https://www.youtube.com/embed/ABC123"
   ========================================================== */

const stories=[
 {title:"La caja que nadie debía abrir",category:"Misterio",emoji:"📦",cls:"",desc:"Después de la muerte de su abuela, Martina recibe una caja con una sola regla: no abrirla hasta cumplir treinta años.",video:""},
 {title:"El mensaje de las 3:17",category:"Drama",emoji:"📱",cls:"blue",desc:"Un mensaje enviado de madrugada parece una equivocación, pero contiene una frase que solo dos personas podían conocer.",video:""},
 {title:"Cinco minutos antes de la boda",category:"Decisiones",emoji:"💍",cls:"red",desc:"Cuando todo está preparado, una desconocida llega con una fotografía que amenaza con cambiar la boda para siempre.",video:""}
];

function render(){
 const grid=document.getElementById("grid");
 grid.innerHTML=stories.map((s,i)=>`
 <article class="card" data-text="${(s.title+" "+s.category+" "+s.desc).toLowerCase()}">
   <div class="thumb ${s.cls}">${s.emoji}</div>
   <div class="card-body">
     <div class="tag">${s.category}</div><h3>${s.title}</h3><p>${s.desc}</p>
     <button class="btn primary watch" onclick="openStory(${i})">▶ Ver Parte 2</button>
   </div>
 </article>`).join("");
}
function filterStories(){
 const q=document.getElementById("search").value.toLowerCase().trim();
 document.querySelectorAll(".card").forEach(c=>c.classList.toggle("hidden",!c.dataset.text.includes(q)));
}
function openStory(i){
 const s=stories[i];
 document.getElementById("home").classList.add("hidden");
 const r=document.getElementById("reader");r.classList.add("active");
 const video=s.video.trim()
   ? `<iframe src="${video}" title="Parte 2 - ${s.title}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`
   : `<div class="video-placeholder"><strong>🎬 Parte 2 — Video próximamente</strong><span>El video de esta historia todavía no fue configurado.</span></div>`;
 document.getElementById("readerContent").innerHTML=`
   <div class="eyebrow">${s.category.toUpperCase()}</div>
   <h1>${s.title}</h1>
   <p class="desc">${s.desc}</p>
   <div class="video">${video}</div>
   <div class="more"><h2>🔥 Más historias</h2><p class="desc">Continúa descubriendo historias de Historias IA.</p></div>`;
 window.scrollTo({top:0,behavior:"smooth"});
}
function showHome(){
 document.getElementById("reader").classList.remove("active");
 document.getElementById("home").classList.remove("hidden");
 window.scrollTo({top:0,behavior:"smooth"});
}
render();
</script>
</body>
</html>
